APP_NAME=PRISM
APP_ENV=local
APP_KEY=
# Set privately before seeding the initial administrator (12+ character password).
# Clear these values and refresh config caches after provisioning.
PRISM_ADMIN_EMAIL=
PRISM_ADMIN_PASSWORD=
# Optional absolute path; otherwise uses storage/app/private/university-service-contacts.php.
# PRISM_US_CONTACTS_FILE=C:/private/university-service-contacts.php
APP_DEBUG=true
LOGIN_OTP_EXPIRE=10
LOGIN_OTP_RESEND_COOLDOWN=60
LOGIN_OTP_CONSOLE=true
# Comma-separated emails that see their OTP code on the verification page
# itself instead of only via email. Still requires entering the code.
# Temporary escape hatch for accounts whose registered inbox isn't reachable.
LOGIN_OTP_REVEAL_EMAILS=
# Set to false to stop emailing OTP codes entirely (e.g. during heavy testing
# so users aren't bombarded). The code is still shown on the verification
# page so login keeps working. Independent of MAIL_MAILER.
LOGIN_OTP_MAIL_ENABLED=true
# Second-factor email OTP for the mobile app login (POST /api/auth/login).
# Off by default so rollout can be staged; while off, mobile login keeps
# returning {access_token, user} directly with no OTP step.
MOBILE_OTP_ENABLED=false
MOBILE_OTP_EXPIRE=5
MOBILE_OTP_RESEND_COOLDOWN=30
MOBILE_OTP_MAX_ATTEMPTS=5
MOBILE_OTP_MAIL_ENABLED=false
APP_URL=http://localhost:8000
PRISM_PUBLIC_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_WARNING_SECONDS=300
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

# One-time account setup links expire after 72 hours.
AUTH_ACCOUNT_SETUP_EXPIRE=4320

PRISM_CASE_RECORD_RETENTION_YEARS=7
PRISM_ATTACHMENT_RETENTION_YEARS=7
PRISM_REPORT_RETENTION_YEARS=5
PRISM_AUDIT_LOG_RETENTION_YEARS=5
PRISM_SCAN_UPLOADS=false
PRISM_MALWARE_SCANNER_BINARY=clamscan
PRISM_MALWARE_SCANNER_TIMEOUT=30
PRISM_ACCESS_REVIEW_INACTIVE_DAYS=90
PRISM_BACKUP_PATH=storage/app/backups
PRISM_RESTORE_TEST_INTERVAL_DAYS=90
PRISM_LAST_RESTORE_TEST_AT=

# Advisory multilingual offense classifier. Start the localhost model service
# before enabling; Laravel safely falls back to keyword suggestions if unavailable.
PRISM_ML_CLASSIFIER_ENABLED=false
PRISM_ML_CLASSIFIER_URL=http://127.0.0.1:8765
PRISM_ML_CLASSIFIER_TOKEN=
PRISM_ML_CONNECT_TIMEOUT=1
PRISM_ML_TIMEOUT=15

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="no-reply@example.com"
MAIL_PASSWORD="replace-with-google-app-password"
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"

# Google reCAPTCHA v2 checkbox. Keep disabled until production keys are configured.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_HOSTNAME=
RECAPTCHA_FAIL_OPEN_ON_CONNECTION_ERROR=false

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true
JWT_COOKIE_ENABLED=true
JWT_COOKIE_NAME=token
JWT_COOKIE_PATH=/api
JWT_COOKIE_DOMAIN=
JWT_COOKIE_SAME_SITE=strict
JWT_CSRF_COOKIE_NAME=API-XSRF-TOKEN
JWT_CSRF_HEADER_NAME=X-API-XSRF-TOKEN
JWT_CSRF_COOKIE_PATH=/

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
