# Test environment.
#
# Laravel loads this file instead of .env when APP_ENV=testing, which phpunit.xml
# sets, so a test run no longer depends on whichever switches a developer happens
# to have flipped locally. That mattered: LOGIN_OTP_MAIL_ENABLED=false in .env
# (there so nobody is emailed a code on every login) silently suppressed the
# notification five login tests assert on, and the suite passed or failed
# depending on whose machine it ran on.
#
# Only what the suite actually needs is set here; everything else falls back to
# the defaults in config/. Nothing below is a real credential, and this file is
# committed on purpose - it is the definition of a reproducible run.

APP_NAME=PRISM
APP_ENV=testing
# Fixtures must not load a developer's private operational contact directory.
PRISM_US_CONTACTS_FILE=
APP_KEY=base64:4g6gKx2bR7iS2L4sg4FP7ns7Oh37t5E6rOC2/WiA5f4=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_MAINTENANCE_DRIVER=file

# Cheap hashing: the suite creates a lot of users and never checks work factor.
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

BROADCAST_CONNECTION=null
CACHE_STORE=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=480

# Collected in memory rather than sent, so Notification/Mail fakes see them.
MAIL_MAILER=array
MAIL_FROM_ADDRESS="prism@example.com"
MAIL_FROM_NAME="PRISM"

# Delivery switches pinned ON, so the tests exercise the real path. These are
# the ones turned off in .env for day-to-day development.
LOGIN_OTP_MAIL_ENABLED=true
LOGIN_OTP_CONSOLE=false
LOGIN_OTP_REVEAL_EMAILS=
MOBILE_OTP_ENABLED=false
MOBILE_OTP_MAIL_ENABLED=true
PASSWORD_OTP_MAIL_ENABLED=true
PASSWORD_OTP_CONSOLE=false
NTE_REMINDER_MAIL_ENABLED=true

# Off by default; the tests that need it call enableRecaptcha() and fake the
# verification request, so no key here is ever used against Google.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=testing-recaptcha-site-key
RECAPTCHA_SECRET_KEY=testing-recaptcha-secret-key
RECAPTCHA_HOSTNAME=localhost

# The suite must not depend on a service being up, so the classifier stays off.
PRISM_ML_CLASSIFIER_ENABLED=false

JWT_SECRET=testing-jwt-secret-key-for-prism-mobile
